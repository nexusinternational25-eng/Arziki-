rules_version = '2';

// Règles Cloud Storage ARZIKI. Tout est interdit par défaut.
service firebase.storage {
  match /b/{bucket}/o {

    function connecte() {
      return request.auth != null;
    }

    function estEquipe() {
      return connecte()
        && request.auth.token.role in ['super_admin', 'admin', 'analyste']
        && request.auth.token.firebase.get('sign_in_second_factor', null) != null;
    }

    // PDF, JPG ou PNG seulement, 10 Mo maximum (section 24).
    function documentAccepte() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
    }

    match /{tout=**} {
      allow read, write: if false;
    }

    // Pièces d'identité : la personne dépose, elle et l'équipe peuvent lire.
    // Pas de modification ni de suppression d'une pièce déjà déposée.
    match /kyc/{uid}/{fichier} {
      allow read: if connecte() && (request.auth.uid == uid || estEquipe());
      allow create: if connecte() && request.auth.uid == uid && documentAccepte();
      allow update, delete: if false;
    }

    // Pièces d'une entreprise (bon de commande, devis) : son dossier, lu par l'équipe.
    match /entreprises/{uid}/{fichier} {
      allow read: if connecte() && (request.auth.uid == uid || estEquipe());
      allow create: if connecte() && request.auth.uid == uid && request.auth.token.role == 'entreprise' && documentAccepte();
      allow update, delete: if false;
    }

    // Actes déposés par un notaire : son dossier, lu par l'équipe. Le serveur les
    // rattache ensuite à l'opération (fonction majGarantie).
    match /notaires/{uid}/{fichier} {
      allow read: if connecte() && (request.auth.uid == uid || estEquipe());
      allow create: if connecte() && request.auth.uid == uid && request.auth.token.role == 'notaire' && documentAccepte();
      allow update, delete: if false;
    }

    // Documents d'une opération (projets de contrats, actes, garanties) : l'équipe
    // dépose et lit. Les autres (entreprise, notaire, partenaires proposés) passent
    // par la fonction lienDocument, qui vérifie l'accès et donne un lien de 15 minutes.
    // Jamais de lien public.
    match /operations/{id}/{fichier} {
      allow read: if estEquipe();
      allow create: if estEquipe() && documentAccepte();
      allow update, delete: if false;
    }
  }
}
