# Copiez ce fichier en .env.local pour travailler sur votre ordinateur.
# Sur Vercel, ces valeurs se saisissent dans Settings > Environment Variables.
# Ne jamais commiter de vraies valeurs.

# Envoi des e-mails (https://resend.com > API Keys)
RESEND_API_KEY=
# Adresse qui reçoit les demandes
CONTACT_TO_EMAIL=operation@amanexus.com
# Expéditeur des e-mails (domaine vérifié dans Resend), par exemple :
# RESEND_FROM="Desk Algérie-Niger <desk@amanexus.com>"
RESEND_FROM=

# Base de données Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site, sans barre finale
NEXT_PUBLIC_SITE_URL=https://desk-algerie-niger.vercel.app

# Mot de passe de l'espace /admin (12 caractères au moins)
ADMIN_PASSWORD=

# Optionnel : Cloudflare Turnstile (anti-robots). Laisser vide pour désactiver.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
